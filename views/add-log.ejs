<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Log Workout - Health Tracker</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <nav>
        <a href="/">Dashboard</a>
        <a href="/about">About</a>
        <a href="/add-log">Log Workout</a>
        <a href="/search">Search Logs</a>
        <a href="/logout">Logout</a>
    </nav>

    <div class="container">
        <!-- Dynamic Progress Bar Header -->
        <div class="profile-header" style="max-width: 600px; margin: 0 auto 20px auto; padding: 20px;">
            <div>
                <h3 style="margin: 0;">Your Progress</h3>
                <div class="progress-bar-bg" style="width: 250px;">
                    <div class="progress-bar-fill" style="width: <%= xpProgress %>%;"></div>
                </div>
                <small style="opacity: 0.8;">Total XP: <%= xp %> (<%= xpProgress %>% to Level <%= level + 1 %>)</small>
            </div>
            <div class="level-badge" style="font-size: 1rem; padding: 5px 15px;">
                🏆 Level <%= level %>
            </div>
        </div>

        <!-- Workout Form Card -->
        <div class="card" style="max-width: 600px; margin: 0 auto;">
            <h2 class="card-title">Log a New Workout</h2>
            
            <% if (message) { %>
                <div style="background: #e8f5e9; border-left: 5px solid #4CAF50; padding: 15px; margin-bottom: 20px; border-radius: 4px;">
                    <p style="color: #2e7d32; font-weight: bold; margin: 0 0 5px 0;">🎉 <%= message %></p>
                    <p style="color: #1b5e20; margin: 0; font-size: 1.1rem;">You earned <strong>+<%= earnedXp %> XP</strong>!</p>
                </div>
            <% } %>

            <form action="/add-log" method="POST">
                <div class="form-group">
                    <label>Activity Type:</label>
                    <input type="text" name="activity_type" placeholder="e.g., Running, Yoga, Weightlifting" required>
                </div>
                <div class="form-group">
                    <label>Duration (minutes):</label>
                    <input type="number" name="duration_minutes" required>
                </div>
                <div class="form-group">
                    <label>Distance (km - optional):</label>
                    <input type="number" step="0.01" name="distance_km">
                </div>
                <div class="form-group">
                    <label>Date:</label>
                    <input type="date" name="log_date" required>
                </div>
                <div class="form-group">
                    <label>Notes:</label>
                    <textarea name="notes" rows="3" placeholder="How did it feel?"></textarea>
                </div>
                <button type="submit" class="btn" style="width: 100%;">Save Workout & Earn XP</button>
            </form>
        </div>
    </div>
</body>
</html>