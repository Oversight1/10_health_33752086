<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Search Logs - Health Tracker</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <nav>
        <a href="/">Dashboard</a>
        <a href="/about">About</a>
        <a href="/add-log">Log Workout</a>
        <a href="/search">Search Logs</a>
        <a href="/logout">Logout</a>
    </nav>

    <div class="container">
        <!-- Search Box Card -->
        <div class="card" style="max-width: 800px; margin: 0 auto 20px auto;">
            <h2 class="card-title">Search Fitness Achievements</h2>
            <form action="/search" method="GET" style="display: flex; gap: 10px;">
                <input type="text" name="q" value="<%= keyword %>" placeholder="Search by activity (e.g., Running) or keyword..." style="flex: 1;">
                <button type="submit" class="btn">Search</button>
            </form>
        </div>

        <!-- Results Card -->
        <% if (keyword) { %>
            <div class="card" style="max-width: 800px; margin: 0 auto;">
                <h2 class="card-title">Results for "<%= keyword %>"</h2>
                
                <% if (results && results.length > 0) { %>
                    <ul class="log-list">
                        <% results.forEach(log => { %>
                            <li class="log-item">
                                <div class="log-details">
                                    <h3 style="margin: 0 0 5px 0; color: #2c3e50;"><%= log.activity_type %></h3>
                                    <p><strong>⏱️ Duration:</strong> <%= log.duration_minutes %> mins 
                                       <% if (log.distance_km) { %>| <strong>📍 Distance:</strong> <%= log.distance_km %> km <% } %>
                                    </p>
                                    <p><strong>📅 Date:</strong> <%= new Date(log.log_date).toLocaleDateString() %></p>
                                    <% if (log.notes) { %><p style="color: #555;"><em>"<%= log.notes %>"</em></p><% } %>
                                </div>

                                <!-- UI Protected Delete Button -->
                                <% if (user && user.id === log.user_id) { %>
                                    <form action="/delete-log/<%= log.id %>" method="POST" style="margin: 0;">
                                        <button type="submit" class="btn btn-danger" onclick="return confirm('Are you sure you want to delete this workout?');">Delete</button>
                                    </form>
                                <% } %>
                            </li>
                        <% }); %>
                    </ul>
                <% } else { %>
                    <p style="color: #666; font-style: italic; text-align: center;">No achievements found matching your search.</p>
                <% } %>
            </div>
        <% } %>
    </div>
</body>
</html>