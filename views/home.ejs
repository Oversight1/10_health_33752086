<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Dashboard - Health Tracker</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <nav>
        <a href="/">Dashboard</a>
        <a href="/about">About</a> 
        <% if (user) { %>
            <a href="/add-log">Log Workout</a>
            <a href="/search">Search Logs</a>
            <a href="/logout">Logout</a>
        <% } else { %>
            <a href="/login">Login</a>
            <a href="/register">Register</a>
        <% } %>
    </nav>

    <div class="container">
        <% if (user) { %>
            <!-- XP & Leveling Header -->
            <div class="profile-header">
                <div>
                    <h1 style="margin: 0;">Welcome back, <%= user.username %>!</h1>
                    <p style="margin: 5px 0 0 0; opacity: 0.9;">Total XP: <%= xp %></p>
                    <div class="progress-bar-bg">
                        <div class="progress-bar-fill" style="width: <%= xpProgress %>%;"></div>
                    </div>
                    <small style="opacity: 0.8;"><%= xpProgress %>% to Level <%= level + 1 %></small>
                </div>
                <div class="level-badge">
                    🏆 Level <%= level %>
                </div>
            </div>

            <div class="dashboard-grid">
                <!-- Left Column: Stats & Chart -->
                <div>
                    <div class="quote">"<%= quoteOfTheDay %>"</div>

                    <div class="card">
                        <h2 class="card-title">Your Fitness Arsenal</h2>
                        <div class="stats-container">
                            <div class="stat-box">
                                <div style="font-size: 1.5rem;">🏋️‍♂️</div>
                                <div>Workouts</div>
                                <div class="stat-value"><%= stats ? stats.total_workouts : 0 %></div>
                            </div>
                            <div class="stat-box">
                                <div style="font-size: 1.5rem;">⏱️</div>
                                <div>Minutes</div>
                                <div class="stat-value"><%= stats ? stats.total_duration : 0 %></div>
                            </div>
                            <div class="stat-box">
                                <div style="font-size: 1.5rem;">📍</div>
                                <div>Distance</div>
                                <div class="stat-value"><%= stats && stats.total_distance ? stats.total_distance : 0 %><span style="font-size: 1rem;">km</span></div>
                            </div>
                        </div>
                        <a href="/add-log" class="btn" style="margin-top: 20px;">Log a New Workout</a>
                    </div>

                    <!-- Distinction Feature: Interactive Chart.js Canvas -->
                    <% if (chartLabels && chartLabels.length > 0) { %>
                        <div class="card">
                            <h2 class="card-title">Time by Activity</h2>
                            <div style="position: relative; height: 250px; width: 100%; display: flex; justify-content: center;">
                                <canvas id="activityChart"></canvas>
                            </div>
                        </div>
                    <% } %>
                </div>

                <!-- Right Column: Global Leaderboard -->
                <div class="card">
                    <h2 class="card-title">🌍 Global Leaderboard</h2>
                    <ul class="leaderboard-list">
                        <% if (leaderboard && leaderboard.length > 0) { %>
                            <% leaderboard.forEach((boardUser, index) => { %>
                                <li class="<%= index === 0 ? 'rank-1' : '' %>">
                                    <span>
                                        <% if (index === 0) { %>🥇<% } else if (index === 1) { %>🥈<% } else if (index === 2) { %>🥉<% } else { %><%= index + 1 %>.<% } %> 
                                        <%= boardUser.username %>
                                        <% if (boardUser.username === user.username) { %>(You)<% } %>
                                    </span>
                                    <span><%= boardUser.total_minutes %> mins</span>
                                </li>
                            <% }); %>
                        <% } else { %>
                            <li>No data available yet.</li>
                        <% } %>
                    </ul>
                </div>
            </div>

        <% } else { %>
            <div style="text-align: center; margin-top: 100px;">
                <h1>Welcome to the Health Tracker</h1>
                <p>Level up your fitness. Compete with friends. Track your legacy.</p>
                <a href="/register" class="btn" style="margin-right: 10px;">Create an Account</a>
                <a href="/login" class="btn" style="background-color: #2c3e50;">Login</a>
            </div>
        <% } %>
    </div>

    <!-- Chart.js Initialization Script -->
    <% if (user && chartLabels && chartLabels.length > 0) { %>
        <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
        <script>
            // We use <%- %> in this case to securely inject the backend arrays directly into the JavaScript
            const ctx = document.getElementById('activityChart').getContext('2d');
            new Chart(ctx, {
                type: 'doughnut',
                data: {
                    labels: <%- JSON.stringify(chartLabels) %>,
                    datasets: [{
                        data: <%- JSON.stringify(chartData) %>,
                        backgroundColor: [
                            '#667eea', '#764ba2', '#00ff88', '#ff4c4c', '#ffd700', '#2196F3'
                        ],
                        borderWidth: 0,
                        hoverOffset: 4
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { position: 'right' }
                    }
                }
            });
        </script>
    <% } %>
</body>
</html>