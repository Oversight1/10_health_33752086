<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Dashboard - Health Tracker</title>
    <style>
        /* UI Styling */
        body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; background-color: #f4f7f6; margin: 0; color: #333; }
        nav { background-color: #2c3e50; padding: 15px; text-align: center; }
        nav a { color: white; text-decoration: none; margin: 0 15px; font-weight: bold; }
        .container { max-width: 1200px; margin: 0 auto; padding: 20px; }
        
        /* Gamer style Header */
        .profile-header { background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; padding: 30px; border-radius: 12px; display: flex; justify-content: space-between; align-items: center; margin-bottom: 30px; box-shadow: 0 4px 6px rgba(0,0,0,0.1); }
        .level-badge { background-color: #ffd700; color: #333; padding: 10px 20px; border-radius: 30px; font-weight: bold; font-size: 1.2rem; }
        .progress-bar-bg { background-color: rgba(255,255,255,0.3); border-radius: 10px; width: 300px; height: 15px; margin-top: 10px; overflow: hidden; }
        .progress-bar-fill { background-color: #00ff88; height: 100%; transition: width 0.5s ease; }

        /* Dashboard Grid */
        .dashboard-grid { display: grid; grid-template-columns: 2fr 1fr; gap: 20px; }
        
        /* Cards */
        .card { background: white; padding: 25px; border-radius: 12px; box-shadow: 0 4px 6px rgba(0,0,0,0.05); }
        .card-title { margin-top: 0; color: #2c3e50; border-bottom: 2px solid #eee; padding-bottom: 10px; margin-bottom: 20px; }
        
        .stats-container { display: flex; gap: 15px; justify-content: space-between; }
        .stat-box { background: #f8fafc; border: 1px solid #e2e8f0; padding: 20px; border-radius: 8px; flex: 1; text-align: center; }
        .stat-value { font-size: 2rem; font-weight: bold; color: #667eea; margin: 10px 0 0 0; }
        
        /* Leaderboard */
        .leaderboard-list { list-style: none; padding: 0; margin: 0; }
        .leaderboard-list li { display: flex; justify-content: space-between; padding: 12px 0; border-bottom: 1px solid #eee; }
        .leaderboard-list li:last-child { border-bottom: none; }
        .rank-1 { font-weight: bold; color: #d4af37; } /* Gold */
        
        .quote { font-style: italic; color: #666; text-align: center; padding: 20px; background: #eef2f5; border-radius: 8px; margin-bottom: 20px; border-left: 5px solid #667eea; }
        .btn { display: inline-block; background-color: #667eea; color: white; padding: 12px 25px; text-decoration: none; border-radius: 6px; font-weight: bold; margin-top: 20px; }
        .btn:hover { background-color: #5a6fd6; }
    </style>
</head>
<body>
    <nav>
        <a href="/">Dashboard</a>
        <a href="/about">About</a> 
        <% if (user) { %>
            <a href="/add-log">Log Workout</a>
            <a href="/search">Search Logs</a>
            <a href="/logout">Logout</a>
        <% } else { %>
            <a href="/login">Login</a>
            <a href="/register">Register</a>
        <% } %>
    </nav>

    <div class="container">
        <% if (user) { %>
            <!-- XP & Leveling Header -->
            <div class="profile-header">
                <div>
                    <h1 style="margin: 0;">Welcome back, <%= user.username %>!</h1>
                    <p style="margin: 5px 0 0 0; opacity: 0.9;">Total XP: <%= xp %></p>
                    <div class="progress-bar-bg">
                        <div class="progress-bar-fill" style="width: <%= xpProgress %>%;"></div>
                    </div>
                    <small style="opacity: 0.8;"><%= xpProgress %>% to Level <%= level + 1 %></small>
                </div>
                <div class="level-badge">
                    🏆 Level <%= level %>
                </div>
            </div>

            <div class="dashboard-grid">
                <!-- Left Column: Quote & Personal Stats -->
                <div>
                    <div class="quote">
                        "<%= quoteOfTheDay %>"
                    </div>

                    <div class="card">
                        <h2 class="card-title">Your Fitness Arsenal</h2>
                        <div class="stats-container">
                            <div class="stat-box">
                                <div style="font-size: 1.5rem;">🏋️‍♂️</div>
                                <div>Workouts</div>
                                <div class="stat-value"><%= stats ? stats.total_workouts : 0 %></div>
                            </div>
                            <div class="stat-box">
                                <div style="font-size: 1.5rem;">⏱️</div>
                                <div>Minutes</div>
                                <div class="stat-value"><%= stats ? stats.total_duration : 0 %></div>
                            </div>
                            <div class="stat-box">
                                <div style="font-size: 1.5rem;">📍</div>
                                <div>Distance</div>
                                <div class="stat-value"><%= stats && stats.total_distance ? stats.total_distance : 0 %><span style="font-size: 1rem;">km</span></div>
                            </div>
                        </div>
                        <a href="/add-log" class="btn">Log a New Workout</a>
                    </div>
                </div>

                <!-- Right Column: Global Leaderboard -->
                <div class="card">
                    <h2 class="card-title">🌍 Global Leaderboard</h2>
                    <ul class="leaderboard-list">
                        <% if (leaderboard && leaderboard.length > 0) { %>
                            <% leaderboard.forEach((boardUser, index) => { %>
                                <li class="<%= index === 0 ? 'rank-1' : '' %>">
                                    <span>
                                        <% if (index === 0) { %>🥇<% } else if (index === 1) { %>🥈<% } else if (index === 2) { %>🥉<% } else { %><%= index + 1 %>.<% } %> 
                                        <%= boardUser.username %>
                                        <% if (boardUser.username === user.username) { %>(You)<% } %>
                                    </span>
                                    <span><%= boardUser.total_minutes %> mins</span>
                                </li>
                            <% }); %>
                        <% } else { %>
                            <li>No data available yet.</li>
                        <% } %>
                    </ul>
                </div>
            </div>

        <% } else { %>
            <!-- Logged Out View -->
            <div style="text-align: center; margin-top: 100px;">
                <h1>Welcome to the Health Tracker</h1>
                <p>Level up your fitness. Compete with friends. Track your legacy.</p>
                <a href="/register" class="btn" style="margin-right: 10px;">Create an Account</a>
                <a href="/login" class="btn" style="background-color: #2c3e50;">Login</a>
            </div>
        <% } %>
    </div>
</body>
</html>

